<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.python-ai-agents-course</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON3__</string>
    <string>-m</string>
    <string>http.server</string>
    <string>4000</string>
    <string>--bind</string>
    <string>127.0.0.1</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/python-ai-agents-course.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/python-ai-agents-course-error.log</string>
</dict>
</plist>
